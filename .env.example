# ═══════════════════════════════════════════════════════════════════════
# templepujasewa — Environment Variables Template (DEMO PLACEHOLDERS)
# ═══════════════════════════════════════════════════════════════════════

# Copy this file to `.env.local` or `.env` and fill in your actual credentials.
# NEVER commit your real `.env` or `.env.local` file to GitHub!
# ═══════════════════════════════════════════════════════════════════════

# ── 1. Business Contact & WhatsApp Configuration ─────────────────────
# WhatsApp Number (Digits only, including country code, e.g. 91 for India):
NEXT_PUBLIC_WHATSAPP_NUMBER=x

# Direct calling phone number:
NEXT_PUBLIC_CONTACT_PHONE=x

# Support / Business email:
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# Official WhatsApp Channel URL (for daily panchang, darshan & pooja updates):
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Vaexample

# Public website URL:
SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Meta (Facebook) Pixel & Conversions API (CAPI) Event Tracking:
# Client-side Pixel ID (publicly visible in browser):
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your_meta_pixel_id_here
# Optional alias for server-side:
META_PIXEL_ID=your_meta_pixel_id_here

# Meta Conversions API (CAPI) Server-to-Server Access Token (Generate in Meta Events Manager -> Settings -> Generate Access Token):
# NEVER expose this token in client-side code or git!
META_ACCESS_TOKEN=your_meta_system_user_access_token_here

# Optional: Meta Graph API Version (defaults to v20.0):
META_GRAPH_API_VERSION=v20.0

# Optional: Meta Test Event Code for verifying in Meta Events Manager "Test Events" tab:
# META_TEST_EVENT_CODE=TEST12345

# ── 2. Admin Portal Credentials ──────────────────────────────────────
# Initial login credentials for the admin dashboard (/admin).
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password_here

# ── 3. MongoDB Atlas (Production Database) ───────────────────────────
# When set, devotee profiles, catalog overrides, and bookings are stored in MongoDB Atlas.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/templepuja
# MONGODB_DB=templepuja

# ── 4. Payment Configuration (UPI QR & Razorpay) ─────────────────────
# Active payment mode: "upi_qr" (default) or "razorpay" (in future when adding live credentials)
NEXT_PUBLIC_PAYMENT_MODE=upi_qr

# Your UPI ID to receive client payments:
NEXT_PUBLIC_UPI_ID=upi_id
NEXT_PUBLIC_UPI_PAYEE_NAME=templepujasewa

# Optional: Static QR image URL if you have an exported QR from PhonePe/GPay/Paytm:
# NEXT_PUBLIC_UPI_QR_IMAGE=/images/upi-qr.png

# ── 5. Razorpay Payment Gateway & Webhook ──────────────────────────────
# Get live keys from https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXXXXXX
# RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
# RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ── 6. Devotee Authentication & Session Security ───────────────────────
# Secret key used to sign and verify HMAC devotee authentication session tokens:
# AUTH_SECRET=your_random_64_character_hex_or_secret_string
# APP_BASE_URL=https://yourdomain.com

# ── 7. Firebase SMS OTP Service (Phone-Based Authentication) ───────────
# Get credentials from Firebase Console -> Project Settings -> General:
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
# NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
# Server-side verification API key (defaults to NEXT_PUBLIC_FIREBASE_API_KEY if omitted):
# FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Note: In development or when Firebase is not configured, a secure fallback OTP challenge
# is automatically dispatched with anti-brute-force rate limiting and cooldowns.

# ── 8. Twilio WhatsApp (Automated Booking Alerts) ─────────────────────
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# ADMIN_WHATSAPP_TO=whatsapp:+919876543210

# ── 9. Automated Reminders & Cron Job Security ───────────────────────
# Secret token for /api/cron/booking-reminders
# CRON_SECRET=your_random_secret_token_here

# ── 10. AI Chatbot Configuration (Optional) ───────────────────────────
# Optional: Set a Google Gemini API key or OpenAI key to empower Pandit AI with LLM reasoning.
# If omitted, the chatbot automatically uses the built-in intelligent RAG semantic retrieval
# engine over your custom admin-trained knowledge base without external dependencies.
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ── 11. Development & Testing Overrides (Optional) ────────────────────
# TTP_STORE=memory
# TTP_DATA_DIR=.data

# ── 12. Message to CEO Email Notifications ─────────────────────────────
# Devotee messages submitted to the CEO are automatically emailed directly to the CEO.
# Recipient email address (defaults to ADMIN_EMAIL or NEXT_PUBLIC_SUPPORT_EMAIL if omitted):
CEO_EMAIL=ceo@yourdomain.com

# Email Delivery Method A: SMTP (Recommended for Gmail, Zoho, Hostinger, Outlook, etc.)
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="templepujasewa Leadership Desk" <your_email@gmail.com>

# Email Delivery Method B: Resend (Alternative HTTP API)
# RESEND_API_KEY=re_123456789
# RESEND_FROM="templepujasewa Desk" <onboarding@resend.dev>



