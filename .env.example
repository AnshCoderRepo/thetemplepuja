# ═══════════════════════════════════════════════════════════════════════
# The Temple Puja — Environment Variables Template (DEMO PLACEHOLDERS)
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to `.env.local` or `.env` and fill in your actual credentials.
# NEVER commit your real `.env` or `.env.local` file to GitHub!
# ═══════════════════════════════════════════════════════════════════════

# ── 1. Business Contact & WhatsApp Configuration ─────────────────────
# WhatsApp Number (Digits only, including country code, e.g. 91 for India):
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Direct calling phone number:
NEXT_PUBLIC_CONTACT_PHONE=+91 98765 43210

# Support / Business email:
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# Public website URL:
SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── 2. Admin Portal Credentials ──────────────────────────────────────
# Initial login credentials for the admin dashboard (/admin).
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password_here

# ── 3. MongoDB Atlas (Production Database) ───────────────────────────
# When set, devotee profiles, catalog overrides, and bookings are stored in MongoDB Atlas.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/templepuja
# MONGODB_DB=templepuja

# ── 4. Razorpay Payment Gateway (Live Payments) ──────────────────────
# Get live keys from https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXXXXXX
# RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── 5. Twilio WhatsApp (Automated Booking Alerts) ─────────────────────
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# ADMIN_WHATSAPP_TO=whatsapp:+919876543210

# ── 6. Automated Reminders & Cron Job Security ───────────────────────
# Secret token for /api/cron/booking-reminders
# CRON_SECRET=your_random_secret_token_here

# ── 7. Development & Testing Overrides (Optional) ────────────────────
# TTP_STORE=memory
# TTP_DATA_DIR=.data

